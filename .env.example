# ─────────────────────────────────────────────────────────────────────────────
# CP-Bot v14 — copy this file to .env and fill in real values.
# Never commit your .env file. All secrets go in here, not in code.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=

# Command prefix for bot commands
PREFIX=!

# Role name (not ID) that grants access to admin commands
ADMIN_ROLE=Admin


# ── Databases ─────────────────────────────────────────────────────────────────
# Supabase connection string. Use the Transaction Pooler URL for Render.
# Settings -> Database -> URI -> Transaction pooler
DATABASE_URL=

# Neon PostgreSQL pool for the Codeforces problem statement/metadata cache.
# Falls back to DATABASE_URL if not set, but a dedicated Neon pool is faster.
DATABASE_URL_CF=

# Neon PostgreSQL pool for LeetCode problem metadata.
DATABASE_URL_LC=


# ── Hosting ───────────────────────────────────────────────────────────────────
# Port the aiohttp API server listens on. Render sets this automatically.
PORT=10000

# Your Render service public URL (used by ping.py for keepalive)
RENDER_URL=

# Seconds to wait after the API starts before connecting to Discord.
# Prevents Discord 429 rate limits on cold-start / redeploy.
BOT_STARTUP_DELAY=120

# Base seconds before retrying Discord connection after a 429/network error.
# Doubles on each retry, capped at 600.
BOT_RETRY_DELAY=60


# ── Website Integration ───────────────────────────────────────────────────────
# Discord server ID. Right-click the server (Developer Mode on) -> Copy Server ID.
GUILD_ID=

# Shared secret between this bot and the website backend.
# Must match BB_API_KEY in your website's server env.
# Generate with: openssl rand -hex 32
BB_API_KEY=

# Comma-separated browser origins allowed to call the API directly.
# Include your production domain, www subdomain, and local dev origins.
BB_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com,https://www.yourdomain.com


# ── Discord OAuth (for website login) ────────────────────────────────────────
# Application -> OAuth2 -> Client ID / Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must match the redirect URI added in Discord Developer Portal -> OAuth2 -> Redirects
DISCORD_REDIRECT_URI=https://yourdomain.com/api/discord/callback


# ── AI Coach (Google Gemini) ──────────────────────────────────────────────────
# Free API key from https://aistudio.google.com
# Powers !coach, !hint, !explain, !review commands.
# Leave blank to disable AI Coach commands gracefully.
GEMINI_API_KEY=


# ── Verification System ───────────────────────────────────────────────────────
# Channel name (without #) where the LinkedIn verification embed is posted
VERIFICATION_CHANNEL=verification

# Channel name where the Zodiac webhook posts the welcome embed on join
WELCOME_CHANNEL=welcome

# Your LinkedIn company/profile page URL shown in the verification embed
LINKEDIN_URL=https://www.linkedin.com/company/yourcompany

# Role name assigned while a member is pending verification
VERIFICATION_ROLE=Verification

# Role name granted after verification (auto-granted instantly on join)
MEMBER_ROLE=Member


# ── Inactivity Tracker ────────────────────────────────────────────────────────
# Channel name where inactivity reports are posted on 15/20/25/30 of each month
INACTIVITY_CHANNEL=inactivity-info

# Channel ID for inactivity reports (takes precedence over INACTIVITY_CHANNEL if set)
INACTIVITY_CHANNEL_ID=

# Legacy flag — no longer used in v14 (auto-kick was removed). Kept for reference.
INACTIVITY_KICK_ENABLED=false


# ── Nightly Check & Leaderboard Announcements ────────────────────────────────
# Channel ID where the 23:58 IST nightly auto-checkall summary is posted.
# Leave blank to skip summary posting (check still runs silently).
CHECKALL_CHANNEL_ID=

# Channel ID where week-end / month-end leaderboard announcements are posted.
LEADERBOARD_ANNOUNCE_CHANNEL_ID=

# Role ID to ping in the period-end announcement. Leave blank to skip the ping.
LEADERBOARD_PING_ROLE_ID=


# ── Contest Reminders ─────────────────────────────────────────────────────────
# Channel name where 12h and 1h contest reminders are posted
CONTEST_REMINDER_CHANNEL=contest-reminder

# Role to ping in contest reminders.
# "everyone" pings @everyone, a role name pings that role, blank = no ping.
CONTEST_REMINDER_ROLE=everyone


# ── Duel System Channel Routing ───────────────────────────────────────────────
# Channel ID or name for each duel mode's match announcements.
# If not set, the bot uses the channel the command was run in.
# Recommended: create a "Duels" category with one channel per mode.
DUEL_CP_DUEL_CHANNEL=
DUEL_CP_BLITZ_CHANNEL=
DUEL_DSA_DUEL_CHANNEL=
DUEL_DSA_BLITZ_CHANNEL=
DUEL_ICPC_DUEL_CHANNEL=
DUEL_ICPC_BLITZ_CHANNEL=
