# ─────────────────────────────────────────────────────────────────────────────
# CP-Bot — copy to .env and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ─────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
PREFIX=!
ADMIN_ROLE=Admin

# ── Database ────────────────────────────────────────────────────────────────
# Supabase / Postgres connection string (pooler URL is fine — the pool is
# already configured with statement_cache_size=0 for PgBouncer).
DATABASE_URL=

# ── Hosting ─────────────────────────────────────────────────────────────────
PORT=10000
RENDER_URL=

# ── Website integration (Phase 1) ───────────────────────────────────────────
# Discord server ID. Required: api_server.py has no Discord context and cannot
# infer the guild the way the cogs do from ctx.guild.id.
GUILD_ID=

# Shared secret with the website backend. Generate with: openssl rand -hex 32
# Must be identical to BB_API_KEY in the website's server/.env.
BB_API_KEY=

# Browser origins allowed to call the API directly (comma-separated).
BB_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# ── Channels & roles (see config.py for the full list) ──────────────────────
VERIFICATION_CHANNEL=verification
WELCOME_CHANNEL=general
MEMBER_ROLE=Member
CONTEST_REMINDER_CHANNEL=contest-reminder
